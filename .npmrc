# The docs site has no private dependencies — the library is built from
# source (see vite.config.js), not installed from a registry.
#
# Pinning the public registry keeps `npm install` from rewriting
# package-lock.json with a private mirror's URLs on machines that have one
# configured globally. That would silently make CI require registry
# credentials it does not otherwise need.
registry=https://registry.npmjs.org/
